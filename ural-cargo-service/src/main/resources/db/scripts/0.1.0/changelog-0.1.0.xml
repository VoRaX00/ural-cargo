<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create schema" author="kerzhakov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ural_cargo
        </sql>
    </changeSet>

    <changeSet id="create table cargo" author="kerzhakov">
        <createTable tableName="cargo">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cargo_type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="cargo_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="length" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="height" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="width" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="weight" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="volume" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="loading_place" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="unloading_place" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="text"/>
            <column name="user_uuid" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
         </createTable>
    </changeSet>
    
    <changeSet id="edit type for columns loading_place and unloading_place" author="kerzhakov">
        <modifyDataType tableName="cargo" columnName="loading_place" newDataType="jsonb"/>
        <modifyDataType tableName="cargo" columnName="unloading_place" newDataType="jsonb"/>
    </changeSet>

</databaseChangeLog>